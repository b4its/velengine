# ==============================================================================
# Laravel Docker Machine Configuration
# Rumus Port: {Port Standar} + 99
# ==============================================================================
COMPOSE_PROJECT_NAME=machine
UID=1000
GID=1000

# Web Application Port (Standar Laravel: 8000 -> 8000 + 99 = 8099)
APP_PORT=8099

# Vite Dev Server Port (Standar Vite: 5173 -> 5173 + 99 = 5272)
VITE_PORT=5272

# Database MySQL Port (Standar MySQL: 3306 -> 3306 + 99 = 3405)
DB_PORT=3405
DB_DATABASE=machine
DB_USERNAME=machine
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# phpMyAdmin Port (Standar PMA: 8080 -> 8080 + 99 = 8179)
PMA_PORT=8179

# Redis Port (Standar Redis: 6379 -> 6379 + 99 = 6478)
REDIS_PORT=6478

# Lokasi folder project Laravel.
# Gunakan '.' jika project berada langsung di root repo ini,
# atau isi dengan nama folder (misal: my-app) jika dibuat via 'laravel new my-app'.
PROJECT_DIR=.
