services:
  app:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        UID: ${UID:-1000}
        GID: ${GID:-1000}
    container_name: ${COMPOSE_PROJECT_NAME:-__COMPOSE_NAME__}-app
    restart: unless-stopped
    user: "${UID:-1000}:${GID:-1000}"
    volumes:
      - .:/var/www/html
    environment:
      - APP_ENV=${APP_ENV:-local}
      - APP_DEBUG=${APP_DEBUG:-true}
      - DB_CONNECTION=mysql
      - DB_HOST=db
      - DB_PORT=3306
      - DB_DATABASE=${DB_DATABASE:-__DB_NAME__}
      - DB_USERNAME=${DB_USERNAME:-__DB_NAME__}
      - DB_PASSWORD=${DB_PASSWORD:-secret}
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - CACHE_STORE=redis
      - SESSION_DRIVER=redis
      - QUEUE_CONNECTION=redis
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_started
    networks:
      - __COMPOSE_NAME__-network

  nginx:
    image: nginx:alpine
    container_name: ${COMPOSE_PROJECT_NAME:-__COMPOSE_NAME__}-nginx
    restart: unless-stopped
    ports:
      - "${APP_PORT:-__APP_PORT__}:80"
      - "${VITE_PORT:-__VITE_PORT__}:5173"
    volumes:
      - .:/var/www/html:ro
      - ./docker/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - app
    networks:
      - __COMPOSE_NAME__-network

  db:
    image: mysql:8.4
    container_name: ${COMPOSE_PROJECT_NAME:-__COMPOSE_NAME__}-db
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: ${DB_DATABASE:-__DB_NAME__}
      MYSQL_USER: ${DB_USERNAME:-__DB_NAME__}
      MYSQL_PASSWORD: ${DB_PASSWORD:-secret}
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD:-root}
    ports:
      - "${DB_PORT:-__DB_PORT__}:3306"
    volumes:
      - db_data:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -u$$MYSQL_USER -p$$MYSQL_PASSWORD || exit 1"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 10s
    networks:
      - __COMPOSE_NAME__-network

  phpmyadmin:
    image: phpmyadmin:latest
    container_name: ${COMPOSE_PROJECT_NAME:-__COMPOSE_NAME__}-pma
    restart: unless-stopped
    environment:
      PMA_HOST: db
      PMA_PORT: 3306
      UPLOAD_LIMIT: 256M
    ports:
      - "${PMA_PORT:-__PMA_PORT__}:80"
    depends_on:
      db:
        condition: service_healthy
    networks:
      - __COMPOSE_NAME__-network

  redis:
    image: redis:7-alpine
    container_name: ${COMPOSE_PROJECT_NAME:-__COMPOSE_NAME__}-redis
    restart: unless-stopped
    ports:
      - "${REDIS_PORT:-__REDIS_PORT__}:6379"
    volumes:
      - redis_data:/data
    networks:
      - __COMPOSE_NAME__-network

networks:
  __COMPOSE_NAME__-network:
    driver: bridge

volumes:
  db_data:
  redis_data:
